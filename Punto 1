    "(", round(n_vertices_simple / n_vertices * 100, 1), "% del original )\n")
sum(st_is_empty(shp_mpio_simple))        # Función no vista: polígonos que desaparecieron al simplificar
nrow(shp_mpio_simple) == nrow(shp_mpio)

